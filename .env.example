# Local Compose only. Copy to .env and replace values. Never commit .env.
MYSQL_ROOT_PASSWORD=replace-local-root-password
DB_USERNAME=quanlydetai
DB_PASSWORD=replace-local-app-password
MYSQL_PORT=3307
PORT=8080
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=bao-cao-de-tai
STORAGE_BACKEND=local
# Used ONLY by tools/Import-SampleData.ps1 (not passed to the web container).
# Optional password for NEW practice accounts; 12-64 characters, max 72 UTF-8 bytes.
SAMPLE_DATA_PASSWORD=

# Local email preview: docker compose --profile mail up -d mailpit
# SMTP host is localhost with native Maven; Compose app uses the mailpit service.
EMAIL_ENABLED=false
EMAIL_BACKEND=smtp
EMAIL_FROM=fit@example.test
EMAIL_API_KEY=
PUBLIC_BASE_URL=http://localhost:8080
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
